schema:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "Represents the country associated with an organization, project, author, or funding entity." .

g4:Topic a owl:Class ;
    rdfs:label "Topic" ;
    rdfs:comment "Represents a research topic described through a set of keywords or a keyword vector." .

g4:project_horizon_2020 a schema:Project ;
    schema:identifier "Horizon 2020" ;
    schema:name "Horizon 2020" .

schema:Project a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "Represents a research or funding project related to scientific publications." .

g4:Paper a owl:Class ;
    rdfs:label "Paper" ;
    rdfs:comment "Represents a scientific paper or publication included in the research funding knowledge graph." .

schema:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Represents an institution, university, research center, company, or funding body involved in the research ecosystem." .

foaf:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Represents a person, usually an author or researcher associated with scientific publications." .

[] a owl:AllDisjointClasses ;
    owl:members ( foaf:Person g4:Paper g4:Topic schema:Country schema:Organization schema:Project ) .

